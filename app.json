
{
  "expo": {
    "name": "Recall",
    "slug": "Recall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png",
      "resizeMode": "contain",
      "backgroundColor": "#242424"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.Natively",
      "icon": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "LSApplicationQueriesSchemes": [
          "comgooglemaps",
          "maps"
        ],
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save and share images.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos for your recalls.",
        "UISupportsDocumentBrowser": true,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "natively",
              "recall"
            ],
            "CFBundleURLName": "com.anonymous.Natively",
            "CFBundleTypeRole": "Editor"
          }
        ]
      },
      "buildNumber": "1.0.0",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.anonymous.Natively"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png",
        "backgroundColor": "#242424",
        "backgroundImage": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png"
      },
      "icon": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png",
      "edgeToEdgeEnabled": false,
      "package": "com.anonymous.Natively",
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ],
          "data": [
            {
              "scheme": "natively"
            },
            {
              "scheme": "recall"
            }
          ]
        },
        {
          "action": "android.intent.action.SEND",
          "category": [
            "android.intent.category.DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        },
        {
          "action": "android.intent.action.SEND",
          "category": [
            "android.intent.category.DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "android.intent.action.SEND_MULTIPLE",
          "category": [
            "android.intent.category.DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "android.intent.action.SEND",
          "category": [
            "android.intent.category.DEFAULT"
          ],
          "data": [
            {
              "mimeType": "video/*"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png",
      "bundler": "metro"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "never",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 21
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "targets": [
            {
              "type": "share-extension",
              "name": "ShareExtension",
              "bundleIdentifier": "com.anonymous.Natively.ShareExtension",
              "deploymentTarget": "15.1",
              "entitlements": {
                "com.apple.security.application-groups": [
                  "group.com.anonymous.Natively"
                ]
              },
              "icon": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png"
            }
          ]
        }
      ],
      "./app.plugin.js"
    ],
    "scheme": "natively",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {}
    }
  },
  "scheme": "Recall"
}
