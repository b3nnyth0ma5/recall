{
  "expo": {
    "name": "Recall",
    "slug": "recall",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#242424"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.b3nny1nc.recall",
      "icon": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSPhotoLibraryUsageDescription": "This app needs access to your photo library to save and share images.",
        "NSPhotoLibraryAddUsageDescription": "Recall saves images to your photo library when you export or share your memories.",
        "NSCameraUsageDescription": "This app needs access to your camera to take photos for your recalls.",
        "NSLocationWhenInUseUsageDescription": "Recall uses your location to tag memories with where they happened.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Recall uses your location to tag memories with where they happened.",
        "UISupportsDocumentBrowser": true,
        "UIFileSharingEnabled": true,
        "LSSupportsOpeningDocumentsInPlace": true,
        "CFBundleURLTypes": [
          {
            "CFBundleURLSchemes": [
              "natively",
              "recall"
            ],
            "CFBundleURLName": "com.b3nny1nc.recall",
            "CFBundleTypeRole": "Editor"
          }
        ],
        "NSUserActivityTypes": ["com.b3nny1nc.recall.search"]
      },
      "buildNumber": "1.0.0",
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.b3nny1nc.recall"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/recall icon.png",
        "backgroundColor": "#242424",
        "backgroundImage": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png"
      },
      "icon": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png",
      "edgeToEdgeEnabled": true,
      "package": "com.b3nny1nc.recall",
      "permissions": [
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "versionCode": 1,
      "intentFilters": [
        {
          "action": "android.intent.action.VIEW",
          "category": [
            "android.intent.category.DEFAULT",
            "android.intent.category.BROWSABLE"
          ],
          "data": [
            {
              "scheme": "natively"
            },
            {
              "scheme": "recall"
            }
          ]
        },
        {
          "action": "android.intent.action.SEND",
          "category": [
            "android.intent.category.DEFAULT"
          ],
          "data": [
            {
              "mimeType": "text/plain"
            }
          ]
        },
        {
          "action": "android.intent.action.SEND",
          "category": [
            "android.intent.category.DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "android.intent.action.SEND_MULTIPLE",
          "category": [
            "android.intent.category.DEFAULT"
          ],
          "data": [
            {
              "mimeType": "image/*"
            }
          ]
        },
        {
          "action": "android.intent.action.SEND",
          "category": [
            "android.intent.category.DEFAULT"
          ],
          "data": [
            {
              "mimeType": "video/*"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png",
      "bundler": "metro"
    },
    "updates": {
      "enabled": false,
      "checkAutomatically": "NEVER",
      "fallbackToCacheTimeout": 0
    },
    "plugins": [
      "expo-font",
      "expo-router",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 21
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      [
        "@bacons/apple-targets",
        {
          "targets": [
            {
              "type": "share-extension",
              "name": "ShareExtension",
              "bundleIdentifier": "com.b3nny1nc.recall.ShareExtension",
              "deploymentTarget": "15.1",
              "entitlements": {
                "com.apple.security.application-groups": [
                  "group.com.b3nny1nc.recall"
                ]
              },
              "icon": "./assets/images/976f1127-ecb6-4965-9721-d979165ced5e.png"
            }
          ]
        }
      ],
      "./app.plugin.js"
    ],
    "scheme": "recall",
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "supabaseUrl": "https://cesmsdnblkdjkskmiqib.supabase.co",
      "supabaseAnonKey": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNlc21zZG5ibGtkamtza21pcWliIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjI1MDc1NzcsImV4cCI6MjA3ODA4MzU3N30.AlULDdolfFFcqfrjXY4XBC_fzD_Gz-bx2FCyqjx4nA4",
      "router": {},
      "eas": {}
    }
  },
  "scheme": "Recall"
}