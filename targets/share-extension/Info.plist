
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>ShareExtension</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>$(PRODUCT_BUNDLE_PACKAGE_TYPE)</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>NSExtension</key>
	<dict>
		<key>NSExtensionAttributes</key>
		<dict>
			<key>NSExtensionActivationRule</key>
			<dict>
				<!-- Support text content -->
				<key>NSExtensionActivationSupportsText</key>
				<true/>
				<!-- Support URLs from web browsers and other apps -->
				<key>NSExtensionActivationSupportsWebURLWithMaxCount</key>
				<integer>10</integer>
				<!-- Support web pages from Safari -->
				<key>NSExtensionActivationSupportsWebPageWithMaxCount</key>
				<integer>10</integer>
				<!-- Support images (JPEG, PNG, HEIC, etc.) -->
				<key>NSExtensionActivationSupportsImageWithMaxCount</key>
				<integer>10</integer>
				<!-- Support videos (MP4, MOV, etc.) -->
				<key>NSExtensionActivationSupportsMovieWithMaxCount</key>
				<integer>10</integer>
				<!-- Support files (PDFs, documents, etc.) -->
				<key>NSExtensionActivationSupportsFileWithMaxCount</key>
				<integer>10</integer>
				<!-- Require at least one item to be shared -->
				<key>NSExtensionActivationSupportsAttachmentsWithMinCount</key>
				<integer>1</integer>
				<!-- Allow up to 10 items to be shared at once -->
				<key>NSExtensionActivationSupportsAttachmentsWithMaxCount</key>
				<integer>10</integer>
			</dict>
		</dict>
		<!-- Extension point identifier for share services -->
		<key>NSExtensionPointIdentifier</key>
		<string>com.apple.share-services</string>
		<!-- Principal class that handles the share extension -->
		<key>NSExtensionPrincipalClass</key>
		<string>ShareViewController</string>
	</dict>
</dict>
</plist>
