{
  "name": "Natively",
  "version": "1.0.0",
  "main": "index.ts",
  "packageManager": "pnpm@10.11.0",
  "scripts": {
    "dev": "EXPO_NO_TELEMETRY=1 expo start --tunnel",
    "android": "EXPO_NO_TELEMETRY=1 expo start --android",
    "ios": "EXPO_NO_TELEMETRY=1 expo start --ios",
    "web": "EXPO_NO_TELEMETRY=1 expo start --web",
    "build:web": "expo export -p web && npx workbox generateSW workbox-config.js",
    "build:android": "expo prebuild -p android",
    "build:ios": "expo prebuild -p ios --clean",
    "build:ios:clean": "rm -rf ios/ && expo prebuild -p ios --clean",
    "lint": "eslint .",
    "verify:share-extension": "echo 'Verifying Share Extension configuration...' && test -d targets/share-extension && echo '✓ Share Extension directory exists' || echo '✗ Share Extension directory missing'"
  },
