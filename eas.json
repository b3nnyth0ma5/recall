{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "pnpm": "10.11.0",
      "distribution": "internal",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EAS_NO_FROZEN_LOCKFILE": "1"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug",
        "image": "latest"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "image": "latest",
        "experimental": {
          "ios": {
            "appExtensions": [
              {
                "targetName": "ShareExtension",
                "bundleIdentifier": "com.b3nny1nc.recall.ShareExtension",
                "entitlements": {
                  "com.apple.security.application-groups": ["group.com.b3nny1nc.recall"]
                }
              }
            ]
          }
        }
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "pnpm": "10.11.0",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EAS_NO_FROZEN_LOCKFILE": "1"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "image": "latest",
        "experimental": {
          "ios": {
            "appExtensions": [
              {
                "targetName": "ShareExtension",
                "bundleIdentifier": "com.b3nny1nc.recall.ShareExtension",
                "entitlements": {
                  "com.apple.security.application-groups": ["group.com.b3nny1nc.recall"]
                }
              }
            ]
          }
        }
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "benny_thomas21@yahoo.co.in",
        "ascAppId": "6755256755",
        "appleTeamId": "9PWN6F3TK8"
      }
    }
  }
}