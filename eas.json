{
  "cli": {
    "version": ">= 5.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "cache": { "disabled": true },
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug",
        "prebuildCommand": "npx expo prebuild -p ios --clean"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "cache": { "disabled": true },
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "prebuildCommand": "npx expo prebuild -p ios --clean"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "cache": { "disabled": true },
      "autoIncrement": true,
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "prebuildCommand": "npx expo prebuild -p ios --clean"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "benny_thomas21@yahoo.co.in",
        "ascAppId": "6755256755",
        "appleTeamId": "9PWN6F3TK8"
      }
    }
  }
}