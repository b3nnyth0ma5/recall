{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "cache": {
        "disabled": true
      },
      "pnpm": "10.11.0",
      "distribution": "internal",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EAS_NO_FROZEN_LOCKFILE": "1"
      },
      "ios": {
        "simulator": true,
        "buildConfiguration": "Debug",
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "preview": {
      "distribution": "internal",
      "cache": {
        "disabled": true
      },
      "pnpm": "10.11.0",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "cache": {
        "disabled": true
      },
      "pnpm": "10.11.0",
      "env": {
        "EAS_BUILD_NO_EXPO_GO_WARNING": "true",
        "EAS_NO_FROZEN_LOCKFILE": "1"
      },
      "ios": {
        "simulator": false,
        "buildConfiguration": "Release",
        "image": "macos-tahoe-26.4-xcode-26.4"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "benny_thomas21@yahoo.co.in",
        "ascAppId": "6755256755",
        "appleTeamId": "9PWN6F3TK8"
      }
    }
  }
}